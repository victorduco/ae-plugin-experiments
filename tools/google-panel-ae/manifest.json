{
  "id": "com.tools.googlepanel",
  "name": "Google",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "aftereffects",
      "minVersion": "24.0.0"
    }
  ],
  "requiredPermissions": {
    "webview": {
      "allow": "yes",
      "domains": ["https://www.google.com", "https://*.google.com"],
      "enableMessageBridge": "localAndRemote"
    }
  },
  "entryPoints": [
    {
      "type": "panel",
      "id": "googlepanel",
      "label": { "default": "Google" },
      "minimumSize": { "width": 400, "height": 300 },
      "preferredDockedSize": { "width": 800, "height": 600 }
    }
  ]
}
